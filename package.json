{
  "name": "stellar-alerts",
  "version": "1.0.0",
  "description": "Stellar Payment Tracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node init && turbo build",
    "typecheck": "turbo typecheck",
    "dev": "node init && turbo dev",
    "dev:api": "node init && npm run dev --workspace=api",
    "dev:worker": "node init && npm run dev:worker --workspace=api",
    "dev:indexer": "node init && npm run dev:indexer --workspace=api",
    "indexer:benchmark": "npm run indexer:benchmark --workspace=api",
    "dev:reporting": "node init && npm run dev:reporting --workspace=api",
    "dev:checksum-worker": "node init && npm run dev:checksum-worker --workspace=api",
    "dev:web": "node init && npm run dev --workspace=web",
    "dev:collab": "node init && npm run dev:collab --workspace=web",
    "db:push": "npm run db:push --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:studio": "npm run db:studio --workspace=api",
    "test:api": "npm run test --workspace=api",
    "test:e2e": "npm run test:e2e --workspace=api",
    "test:coverage": "npm run test:coverage --workspace=api",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "test": "npm run test --workspaces --if-present",
    "generate:types": "tsx scripts/generate-types.ts",
    "generate:types:check": "tsx scripts/generate-types.ts --check",
    "openapi:check:breaking": "tsx scripts/check-openapi-breaking-changes.ts",
    "benchmark:stream": "tsx scripts/benchmark-stream.ts",
    "security:audit": "osv-scanner scan source -r . --config osv-scanner.toml",
    "verify:migrations": "npx tsx scripts/verify-migrations.ts",
    "verify:migrations:dry-run": "npx tsx scripts/verify-migrations.ts --dry-run",
    "verify:migrations:shadow": "npx tsx scripts/verify-migrations-shadow.ts",
    "validate:dependabot": "node scripts/validate-dependabot.js",
    "prepare": "husky"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "openapi-diff": "^0.24.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.1",
    "turbo": "^2.1.0",
    "typescript": "^5.9.3"
  }
}
